# ═══════════════════════════════════════════════════════════════
# Scholnexa | monorepo root environment
# ═══════════════════════════════════════════════════════════════
# Convenience copy for local development. The backend reads
# backend/.env (see backend/.env.example) and the frontend reads
# frontend/.env (see frontend/.env.example). The production
# configuration lives in .env.production (see
# .env.production.example) and is consumed by deploy.sh and the
# Docker Swarm stack.
# ═══════════════════════════════════════════════════════════════

# Docker Compose development stack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_crm

# Default stack name used by deploy.sh
STACK_NAME=school-crm

# Production (see .env.production.example for the full list):
# DOMAIN=scholnexa.example.com
# DB_PASSWORD=
# REDIS_PASSWORD=
# JWT_SECRET=
# ADMIN_API_KEY=
