# ═══════════════════════════════════════════════════════════════
# Scholnexa — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in all values.
#
#   cp .env.production.example .env.production
#   nano .env.production
#   ./deploy.sh
#
# Architecture:
#   scholnexa-nginx (reverse proxy, TLS) → https://DOMAIN/
#   https://DOMAIN/        → nginx → React SPA
#   https://DOMAIN/api/*   → proxy → Backend API (Fastify)
#   https://DOMAIN/health  → proxy → Backend health check
#
# Generate secure random values with:
#   openssl rand -hex 32      (JWT_SECRET)
#   openssl rand -hex 16      (DB_PASSWORD, REDIS_PASSWORD)
#   openssl rand -base64 32   (ADMIN_API_KEY)
# ═══════════════════════════════════════════════════════════════

# ─── Required — MUST set these ─────────────────────────────────

# Main domain (both frontend and API are served here)
DOMAIN=

# Database
DB_PASSWORD=                               # Strong random password for PostgreSQL

# Redis
REDIS_PASSWORD=                            # Strong random password for Redis

# Supabase (recommended — replaces the self-hosted PostgreSQL + MinIO)
# When DATABASE_URL is set it overrides the local postgres service and exam
# documents are stored in Supabase Storage instead of MinIO.
DATABASE_URL=			      # e.g. postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=			      # e.g. https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=	 # Dashboard → Project Settings → API
SUPABASE_STORAGE_BUCKET=examens

# JWT Authentication
JWT_SECRET=                                # Long random string (min 32 chars)
JWT_EXPIRES_IN=24h                         # Token lifetime (24h recommended)

# Admin API key (for SuperAdmin CRM multi-product integration)
ADMIN_API_KEY=                             # Random API key

# Grafana monitoring dashboard password
GRAFANA_PASSWORD=                          # Grafana admin password (defaults to "admin" if not set!)

# Let's Encrypt certificate notifications
ACME_EMAIL=

# ─── Optional — set if you use these features ──────────────────

# SMTP / Email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@${DOMAIN}
ADMIN_EMAIL=admin@${DOMAIN}

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# n8n Automation Webhook
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# AI Agent (NVIDIA NIM integration)
# Get a free API key at: https://build.nvidia.com/explore/retrieval
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct

# Logging
LOG_LEVEL=info
