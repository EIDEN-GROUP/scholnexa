# ═══════════════════════════════════════════════════════════════
# Scholnexa | Backend environment (development)
# ═══════════════════════════════════════════════════════════════
# Copy to backend/.env  →  npm run dev
#
#   cp .env.example .env
#
# Production values live in the root .env.production (see
# .env.production.example at the repository root).
# ═══════════════════════════════════════════════════════════════

# ─── Core ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database (Supabase PostgreSQL) ────────────────────────────
# Connection string to the Supabase Postgres. Recommended:
#   API / pooler:  postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Migrations:    postgresql://postgres.<ref>:<db-password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_crm

# ─── Authentication ────────────────────────────────────────────
# REQUIRED in production | generate with:  openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Redis (cache + BullMQ background jobs) ────────────────────
REDIS_URL=redis://localhost:6379

# ─── Supabase Storage (exam documents) ─────────────────────────
# Project URL + service role key: Supabase Dashboard → Project Settings → API.
# The service role key is REQUIRED in production (boot fails without it).
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=examens

# ─── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@scholnexa.com
ADMIN_EMAIL=admin@scholnexa.com

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (the frontend URL).
CORS_ORIGIN=http://localhost:5173

# ─── Admin API (multi-product integration) ─────────────────────
# REQUIRED in production | generate with:  openssl rand -base64 32
ADMIN_API_KEY=change-me-to-a-random-secret

# ─── WhatsApp Cloud API (optional) ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0

# ─── n8n automation webhook (optional) ─────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ─── AI Agent (OpenAI-compatible, optional) ────────────────────
# Get a free key at https://build.nvidia.com/explore/retrieval
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Examples: meta/llama-3.1-8b-instruct, mistralai/mixtral-8x22b-instruct-v0.1
AI_MODEL=meta/llama-3.1-8b-instruct
