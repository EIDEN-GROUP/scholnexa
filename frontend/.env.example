# ═══════════════════════════════════════════════════════════════
# Scholnexa — Frontend environment (Vite)
# ═══════════════════════════════════════════════════════════════
# Copy to frontend/.env  →  npm run dev
#
#   cp .env.example .env
#
# All variables must be prefixed with VITE_ to be exposed to the
# browser bundle. Set VITE_API_URL on Vercel / Netlify / the VPS to
# point at the production backend, e.g. https://api.example.com/api
# ═══════════════════════════════════════════════════════════════

# Base URL of the backend API (dev default: local Fastify).
VITE_API_URL=http://localhost:3000/api

# Contact email shown in the admin/support UI.
VITE_ADMIN_EMAIL=admin@scholnexa.com
